+      range_layer:   # the two sonars, via robot/sonar_range.py (2026-09-28)
+        plugin: "nav2_costmap_2d::RangeSensorLayer"
+        enabled: True
+        topics: ["/sonar/front", "/sonar/rear"]
+        input_sensor_type: VARIABLE
+        # A reading at max_range (4.0 - its no-echo 4.5 is sent as 4.0) clears
