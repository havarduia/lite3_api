+    /// Obstacle avoidance (voa_composition) subscribes to cmd_vel and republishes
+    /// a corrected Twist on cmd_vel_corrected. This node listens to both, so
+    /// without this guard every command reached the robot twice - raw and
+    /// corrected, racing - and VOA could never actually veto anything.
+    /// While corrections are arriving, the corrected stream is authoritative and
+    /// the raw one is dropped. When VOA is not running no corrections arrive, so
+    /// raw cmd_vel passes through as before and nothing else breaks.
+    void CmdVelCorrectedCallback(const geometry_msgs::msg::Twist::SharedPtr msg){
+        last_corrected_ = std::chrono::steady_clock::now();
+        SendVelocity(msg);
+    }
+
     void CmdVelCallback(const geometry_msgs::msg::Twist::SharedPtr msg){
+        auto since = std::chrono::steady_clock::now() - last_corrected_;
+        if (since < std::chrono::milliseconds(500)) {
+            return;   // VOA is live; only its corrected output may drive the robot
+        }
+        SendVelocity(msg);
+    }
