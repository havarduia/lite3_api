+    /// Lite3: is a topic capped at hz due again? Counts a packet that is up
+    /// to half a packet interval early as due, so 50 gives every third
+    /// packet (53 Hz), not every fourth (40 Hz).
+    bool Due(std::chrono::steady_clock::time_point &last, double hz){
+        auto now = std::chrono::steady_clock::now();
+        if(hz > 0 && std::chrono::duration<double>(now - last).count() < 1.0 / hz - 0.003){
+            return false;
+        }
+        last = now;
+        return true;
+    }
