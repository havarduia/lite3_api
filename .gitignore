__pycache__/
*.py[cod]

# Never commit the Gemini key, wherever it ends up.
.gemini_key
*.key

# Stray backups. The pre-git ones lived in archive/ up to commit c4cfb84.
/*.bak
/*.orig
robot/persona_private.py

# Dense rviz meshes, fetched by robot/rviz.py on first run (73 MB).
/urdf/meshes_hd/

# Recordings from robot/rviz.py --record.
*.rec
